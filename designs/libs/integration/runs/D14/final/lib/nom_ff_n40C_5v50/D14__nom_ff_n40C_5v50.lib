library (D14) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1mA";
  pulling_resistance_unit        : "1ohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 30;
  slew_lower_threshold_pct_fall : 30;
  slew_upper_threshold_pct_rise : 70;
  slew_upper_threshold_pct_fall : 70;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 5.50;


  cell ("D14") {
    is_macro_cell : true;
    pin("Vin") {
      direction : inout;
      capacitance : 0.1285;
    }
    pin("Vin_neg") {
      direction : inout;
      capacitance : 0.1084;
    }
    pin("vout_1") {
      direction : inout;
      capacitance : 0.1619;
    }
    pin("vout_2") {
      direction : inout;
      capacitance : 0.1573;
    }
    pin("vpost1") {
      direction : inout;
      capacitance : 0.1545;
    }
    pin("vpost2") {
      direction : inout;
      capacitance : 0.1785;
    }
    pin("vpre1") {
      direction : inout;
      capacitance : 0.1114;
    }
    pin("vpre2") {
      direction : inout;
      capacitance : 0.1087;
    }
  }

}
