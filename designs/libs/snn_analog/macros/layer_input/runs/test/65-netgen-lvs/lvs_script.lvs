readnet verilog /foss/designs/libs/snn_analog/macros/layer_input/runs/test/40-openroad-detailedrouting/layer_input.pnl.v $circuit2
lvs "$circuit1 layer_input" "$circuit2 layer_input" /usr/local/lib/python3.12/dist-packages/librelane/scripts/netgen/setup.tcl /foss/designs/libs/snn_analog/macros/layer_input/runs/test/65-netgen-lvs/reports/lvs.netgen.rpt -blackbox -json
