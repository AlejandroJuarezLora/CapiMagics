VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN layer_output ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 400000 300000 ) ;
ROW ROW_0 GF018hv5v_mcu_sc7 13440 31360 N DO 333 BY 1 STEP 1120 0 ;
ROW ROW_1 GF018hv5v_mcu_sc7 13440 39200 FS DO 333 BY 1 STEP 1120 0 ;
ROW ROW_2 GF018hv5v_mcu_sc7 13440 47040 N DO 333 BY 1 STEP 1120 0 ;
ROW ROW_3 GF018hv5v_mcu_sc7 13440 54880 FS DO 333 BY 1 STEP 1120 0 ;
ROW ROW_4 GF018hv5v_mcu_sc7 13440 62720 N DO 333 BY 1 STEP 1120 0 ;
ROW ROW_5 GF018hv5v_mcu_sc7 13440 70560 FS DO 333 BY 1 STEP 1120 0 ;
ROW ROW_27 GF018hv5v_mcu_sc7 13440 243040 FS DO 333 BY 1 STEP 1120 0 ;
ROW ROW_28 GF018hv5v_mcu_sc7 13440 250880 N DO 333 BY 1 STEP 1120 0 ;
ROW ROW_29 GF018hv5v_mcu_sc7 13440 258720 FS DO 333 BY 1 STEP 1120 0 ;
TRACKS X 560 DO 357 STEP 1120 LAYER Metal1 ;
TRACKS Y 560 DO 268 STEP 1120 LAYER Metal1 ;
TRACKS X 560 DO 357 STEP 1120 LAYER Metal2 ;
TRACKS Y 560 DO 268 STEP 1120 LAYER Metal2 ;
TRACKS X 560 DO 357 STEP 1120 LAYER Metal3 ;
TRACKS Y 560 DO 268 STEP 1120 LAYER Metal3 ;
TRACKS X 560 DO 357 STEP 1120 LAYER Metal4 ;
TRACKS Y 560 DO 268 STEP 1120 LAYER Metal4 ;
TRACKS X 900 DO 222 STEP 1800 LAYER Metal5 ;
TRACKS Y 900 DO 166 STEP 1800 LAYER Metal5 ;
COMPONENTS 2 ;
    - x1 neurona_lvs + FIXED ( 40000 100000 ) N ;
    - x2 neurona_lvs + FIXED ( 240000 100000 ) N ;
END COMPONENTS
PINS 8 ;
    - Iext1 + NET Iext1 + DIRECTION INPUT + USE SIGNAL ;
    - Iext2 + NET Iext2 + DIRECTION INPUT + USE SIGNAL ;
    - nvout_1 + NET nvout_1 + DIRECTION OUTPUT + USE SIGNAL ;
    - nvout_2 + NET nvout_2 + DIRECTION OUTPUT + USE SIGNAL ;
    - vdd + NET vdd + DIRECTION INOUT + USE SIGNAL ;
    - vout_1 + NET vout_1 + DIRECTION OUTPUT + USE SIGNAL ;
    - vout_2 + NET vout_2 + DIRECTION OUTPUT + USE SIGNAL ;
    - vss + NET vss + DIRECTION INOUT + USE SIGNAL ;
END PINS
SPECIALNETS 2 ;
    - vdd ( PIN vdd ) + USE POWER ;
    - vss ( PIN vss ) + USE GROUND ;
END SPECIALNETS
NETS 8 ;
    - Iext1 ( PIN Iext1 ) ( x1 Iin ) + USE SIGNAL ;
    - Iext2 ( PIN Iext2 ) ( x2 Iin ) + USE SIGNAL ;
    - nvout_1 ( PIN nvout_1 ) ( x1 spike_neg ) + USE SIGNAL ;
    - nvout_2 ( PIN nvout_2 ) ( x2 spike_neg ) + USE SIGNAL ;
    - vdd ( PIN vdd ) ( x2 vdd ) ( x1 vdd ) + USE POWER ;
    - vout_1 ( PIN vout_1 ) ( x1 spike ) + USE SIGNAL ;
    - vout_2 ( PIN vout_2 ) ( x2 spike ) + USE SIGNAL ;
    - vss ( PIN vss ) ( x2 vss ) ( x1 vss ) + USE GROUND ;
END NETS
END DESIGN
