      + LAYER Metal2 WIDTH 560
      + LAYER Metal3 WIDTH 560 SPACING 3000
      + LAYER Metal4 WIDTH 560
      + LAYER Metal5 WIDTH 880
    ;
END NONDEFAULTRULES
COMPONENTS 2 ;
