library (neurona_lvs_lib) {
  cell (neurona_lvs) {
    area : 4024.86;
    pin (Vdd) {
      direction : inout;
      pg_type : primary_power;
    }
    pin (Vss) {
      direction : inout;
      pg_type : primary_ground;
    }
    pin (Vin) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Vin_neg) {
      direction : input;
      capacitance : 0.001;
    }
    pin (Iex_1_i) {
      direction : output;
      capacitance : 0.001;
    }
    pin (Iex_2_i) {
      direction : output;
      capacitance : 0.001;
    }
    pin (Iex_3_i) {
      direction : output;
      capacitance : 0.001;
    }
    pin (Iex_4_i) {
      direction : output;
      capacitance : 0.001;
    }
  }
}
