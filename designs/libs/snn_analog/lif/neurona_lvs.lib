library (neurona_lvs_lib) {
  cell (neurona_lvs) {
    area : 4874.145;
    pin (vdd) {
      direction : inout;
      pg_type : primary_power;
    }
    pin (vss) {
      direction : inout;
      pg_type : primary_ground;
    }
    pin (Iin) {
      direction : input;
      capacitance : 0.001;
    }
    pin (spike) {
      direction : output;
      capacitance : 0.001;
    }
    pin (spike_neg) {
      direction : output;
      capacitance : 0.001;
    }
  }
}
