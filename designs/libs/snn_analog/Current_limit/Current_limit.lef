VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO Current_limit
  CLASS BLOCK ;
  FOREIGN Current_limit ;
  ORIGIN 6.200 9.700 ;
  SIZE 12.895 BY 16.500 ;
  PIN i_SUM
    ANTENNADIFFAREA 0.300000 ;
    PORT
      LAYER Metal2 ;
        RECT 6.190 0.390 6.200 0.400 ;
    END
  END i_SUM
  PIN ifwd
    ANTENNAGATEAREA 2.500000 ;
    ANTENNADIFFAREA 0.300000 ;
    PORT
      LAYER Metal2 ;
        RECT 5.945 -8.595 6.445 -5.595 ;
    END
  END ifwd
  OBS
      LAYER Nwell ;
        RECT -4.430 -9.700 4.430 2.800 ;
      LAYER Metal1 ;
        RECT -4.200 -9.490 4.200 6.550 ;
      LAYER Metal2 ;
        RECT -6.200 0.700 6.695 6.800 ;
        RECT -6.200 0.090 5.890 0.700 ;
        RECT 6.500 0.090 6.695 0.700 ;
        RECT -6.200 -5.295 6.695 0.090 ;
        RECT -6.200 -8.895 5.645 -5.295 ;
        RECT -6.200 -9.490 6.695 -8.895 ;
      LAYER Metal3 ;
        RECT -5.330 -6.505 6.445 6.550 ;
  END
END Current_limit
END LIBRARY

